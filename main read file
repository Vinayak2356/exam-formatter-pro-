<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Project Documentation & Architecture Guide</title>
  <!-- Inter font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #0b0f19;
      --card: #111827;
      --card-border: #1f2937;
      --text: #9ca3af;
      --text-header: #f9fafb;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --primary-glow: rgba(59, 130, 246, 0.15);
      --accent: #10b981;
      --accent-glow: rgba(16, 185, 129, 0.15);
      --code-bg: #1f2937;
      --sidebar-width: 280px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      display: flex;
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: var(--bg);
    }
    ::-webkit-scrollbar-thumb {
      background: var(--card-border);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #374151;
    }

    /* Sidebar Navigation */
    aside {
      width: var(--sidebar-width);
      background: var(--card);
      border-right: 1px solid var(--card-border);
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      padding: 2rem 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      z-index: 10;
      overflow-y: auto;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-logo {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      color: #fff;
      font-size: 1.1rem;
    }

    .brand-name {
      font-weight: 800;
      font-size: 1.1rem;
      color: var(--text-header);
      letter-spacing: -0.025em;
    }

    .nav-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .nav-item a {
      display: block;
      padding: 0.75rem 1rem;
      color: var(--text);
      text-decoration: none;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.2s;
    }

    .nav-item a:hover {
      color: var(--text-header);
      background: rgba(255, 255, 255, 0.03);
    }

    .nav-item.active a {
      color: var(--primary);
      background: var(--primary-glow);
      font-weight: 600;
    }

    /* Main Content */
    main {
      margin-left: var(--sidebar-width);
      flex: 1;
      padding: 3rem 4rem;
      max-width: 1200px;
    }

    header {
      margin-bottom: 3rem;
      position: relative;
    }

    header::after {
      content: '';
      position: absolute;
      bottom: -1.5rem;
      left: 0;
      width: 80px;
      height: 4px;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      border-radius: 2px;
    }

    h1 {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--text-header);
      letter-spacing: -0.05em;
      margin-bottom: 0.5rem;
    }

    h2 {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--text-header);
      letter-spacing: -0.03em;
      margin-top: 3.5rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    h3 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--text-header);
      margin-top: 2rem;
      margin-bottom: 1rem;
    }

    p {
      margin-bottom: 1.5rem;
      font-size: 1rem;
      line-height: 1.7;
    }

    /* Links & Buttons */
    .link-group {
      display: grid;
      grid-template-cols: 1fr;
      gap: 1.5rem;
      margin: 2rem 0;
    }

    @media (min-width: 768px) {
      .link-group {
        grid-template-columns: 1fr 1fr;
      }
    }

    .link-card {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      transition: all 0.2s;
    }

    .link-card:hover {
      border-color: #374151;
      transform: translateY(-2px);
      box-shadow: 0 10px 20px -10px rgba(0, 0, 0, 0.5);
    }

    .link-title {
      font-weight: 700;
      color: var(--text-header);
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .link-url {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: var(--primary);
      text-decoration: none;
      word-break: break-all;
    }

    .btn-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0.6rem 1.2rem;
      background: var(--primary);
      color: #fff;
      text-decoration: none;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      transition: background 0.2s;
      align-self: flex-start;
    }

    .btn-action:hover {
      background: var(--primary-hover);
    }

    .btn-accent {
      background: var(--accent);
    }
    .btn-accent:hover {
      background: #059669;
    }

    /* Grid & Cards */
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    @media (min-width: 768px) {
      .grid-2 {
        grid-template-columns: 1fr 1fr;
      }
    }

    .feature-card {
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.5rem;
      position: relative;
      overflow: hidden;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: var(--primary);
    }

    .feature-card.accent::before {
      background: var(--accent);
    }

    /* Table formatting */
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.5rem 0;
      background: var(--card);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      overflow: hidden;
    }

    th, td {
      padding: 1rem 1.25rem;
      text-align: left;
    }

    th {
      background: #1f2937;
      color: var(--text-header);
      font-weight: 600;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    td {
      border-bottom: 1px solid var(--card-border);
      font-size: 0.95rem;
    }

    tr:last-child td {
      border-bottom: none;
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.6rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      border: 1px solid transparent;
    }

    .badge-primary {
      background: var(--primary-glow);
      color: var(--primary);
      border-color: rgba(59, 130, 246, 0.3);
    }

    .badge-accent {
      background: var(--accent-glow);
      color: var(--accent);
      border-color: rgba(16, 185, 129, 0.3);
    }

    /* Code blocks */
    pre, code {
      font-family: 'JetBrains Mono', monospace;
    }

    pre {
      background: #111827;
      border: 1px solid var(--card-border);
      padding: 1.5rem;
      border-radius: 12px;
      overflow-x: auto;
      margin: 1.5rem 0;
    }

    code {
      font-size: 0.9rem;
      color: #38bdf8;
    }

    .inline-code {
      background: var(--code-bg);
      padding: 0.2rem 0.4rem;
      border-radius: 6px;
      color: #f43f5e;
      font-size: 0.85rem;
    }

    /* Mobile Toggle */
    .mobile-nav-toggle {
      display: none;
    }

    @media (max-width: 768px) {
      aside {
        transform: translateX(-100%);
        transition: transform 0.3s;
      }

      aside.open {
        transform: translateX(0);
      }

      main {
        margin-left: 0;
        padding: 2rem 1.5rem;
      }

      .mobile-nav-toggle {
        display: block;
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        width: 56px;
        height: 56px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 50%;
        box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);
        z-index: 100;
        font-weight: 800;
        cursor: pointer;
      }
    }
  </style>
</head>
