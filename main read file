        <li><span class="badge badge-accent">POST</span> <code class="inline-code">/api/patterns</code> — Creates a pattern. (Admin Only)</li>
        <li><span class="badge badge-accent">PUT</span> <code class="inline-code">/api/patterns/{id}</code> — Updates a pattern. (Admin Only)</li>
        <li><span class="badge badge-accent">DELETE</span> <code class="inline-code">/api/patterns/{id}</code> — Deletes a pattern. (Admin Only)</li>
      </ul>
