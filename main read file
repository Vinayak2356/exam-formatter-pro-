  "password": "admin123"
}

// Response Body
{
  "token": "eyJhbGciOiJIUzI1...",
  "email": "admin@systemdesign.com",
  "role": "ADMIN"
}</code></pre>

      <h3>Patterns Library (PatternController)</h3>
